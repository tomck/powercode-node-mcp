{
  "name": "powercode-mcp",
  "version": "0.2.0",
  "description": "MCP server for the Powercode REST API (ISP/WISP billing and management): customers, tickets, billing, equipment. Read-only by default.",
  "type": "module",
  "bin": {
    "powercode-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "powercode",
    "isp",
    "wisp",
    "billing",
    "tickets"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Tom Koch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomck/powercode-node-mcp.git"
  },
  "homepage": "https://github.com/tomck/powercode-node-mcp#readme",
  "bugs": {
    "url": "https://github.com/tomck/powercode-node-mcp/issues"
  }
}
